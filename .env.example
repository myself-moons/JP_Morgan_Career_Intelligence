# ==============================================================================
# JCI Career Studio v3.0 — Environment Configuration Template
# Copy to .env for local development. For Cloud Run, store secrets in
# Google Secret Manager and inject them as environment variables at deploy time.
# ==============================================================================

# --- Database ---
# Leave unset for local SQLite (data/jci_local.db), or set a PostgreSQL URL:
# Neon / External Postgres:
#   DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Cloud SQL (Unix socket on Cloud Run):
#   DATABASE_URL=postgresql+psycopg://USER:PASSWORD@/DBNAME?host=/cloudsql/PROJECT_ID:REGION:INSTANCE_NAME
DATABASE_URL=

# --- Google OAuth 2.0 / OIDC Sign-In ---
# Create an OAuth 2.0 Web Client ID in Google Cloud Console -> APIs & Services -> Credentials.
# Add both http://localhost:5173 (dev) and https://YOUR_CLOUD_RUN_URL (prod) to Authorized JavaScript origins.
GOOGLE_CLIENT_ID=

# Enforce Google Sign-In on all workspace routes (recommended: true in production)
JCI_AUTH_REQUIRED=true

# Comma-separated Google account emails allowed to run admin actions
# (live JPMC job sync, baseline seeding, global taxonomy management)
JCI_ADMIN_EMAILS=

# --- Session Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# REQUIRED in production so user sessions persist across Cloud Run container restarts/scaling.
JWT_SECRET=

# Set true in HTTPS production (auto-enabled on Cloud Run when K_SERVICE is set)
JCI_COOKIE_SECURE=false

# --- Gemini AI (Mini-RAG & Roadmap Reviews) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_DEEP_MODEL=gemini-2.5-pro
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
JCI_GEMINI_TIMEOUT_SECONDS=45
JCI_AI_RATE_LIMIT_PER_HOUR=30

# --- Server & Edge Protection ---
JCI_HOST=127.0.0.1
PORT=8000
JCI_SERVE_FRONTEND=false
JCI_CORS_ORIGINS=
JCI_IP_RATE_LIMIT_PER_MIN=120
JCI_AUTH_IP_RATE_LIMIT_PER_MIN=20
JCI_MAX_UPLOAD_BYTES=10485760
